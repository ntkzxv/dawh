# Supabase PostgreSQL — server only.
# Use the Transaction Pooler connection string in development and Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=1
# Optional: Supabase Postgres CA certificate (PEM). Use literal \\n between lines on Vercel.
DATABASE_SSL_CA=

# Better Auth — server only.
BETTER_AUTH_SECRET=replace-with-a-random-base64-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Employee onboarding — server only.
CURRENT_TERMS_VERSION=2026-09-19

# Resend — optional. Keep false until the sender/domain is ready.
AUTH_EMAIL_ENABLED=false
RESEND_API_KEY=
AUTH_EMAIL_FROM=
